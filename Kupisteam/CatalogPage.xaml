<Page x:Class="Kupisteam.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог" Unloaded="Page_Unloaded" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="40,20,40,0" MaxWidth="1240">

                <!-- ===== СИНЯЯ ПАНЕЛЬ МАГАЗИНА (жанры + поиск) ===== -->
                <Border Height="36" Background="{StaticResource StoreNavBrush}">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel x:Name="GenresPanel" Orientation="Horizontal">
                            <Button Content="Все игры" Tag="Все" Style="{StaticResource StoreNavButton}" Click="Genre_Click"/>
                            <Button Content="RPG" Tag="RPG" Style="{StaticResource StoreNavButton}" Click="Genre_Click"/>
                            <Button Content="Экшен" Tag="Экшен" Style="{StaticResource StoreNavButton}" Click="Genre_Click"/>
                            <Button Content="Кооператив" Tag="Кооператив" Style="{StaticResource StoreNavButton}" Click="Genre_Click"/>
                            <Button Content="Инди" Tag="Инди" Style="{StaticResource StoreNavButton}" Click="Genre_Click"/>
                            <Button Content="Скидки" Tag="Скидки" Style="{StaticResource StoreNavButton}" Click="Genre_Click"/>
                        </StackPanel>
                        <Grid HorizontalAlignment="Right" Width="240" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Tag="поиск"
                                     Height="26" TextChanged="SearchBox_TextChanged"/>
                            <Border Width="24" Height="22" Background="#66C0F4" CornerRadius="2"
                                    HorizontalAlignment="Right" Margin="0,0,2,0" IsHitTestVisible="False">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#1B2838"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== РЕКОМЕНДУЕМОЕ (карусель) ===== -->
                <TextBlock Text="РЕКОМЕНДУЕМОЕ" Style="{StaticResource SectionTitle}" Margin="0,30,0,0"/>
                <Border Style="{StaticResource SectionLine}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="&#xE76B;" Style="{StaticResource ArrowButton}" HorizontalAlignment="Left"
                            Click="Prev_Click"/>
                    <Button Grid.Column="2" Content="&#xE76C;" Style="{StaticResource ArrowButton}"
                            HorizontalAlignment="Right" Click="Next_Click"/>

                    <Grid Grid.Column="1" Height="350">
                        <Grid.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                        </Grid.Effect>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- картинка -->
                        <Border x:Name="BannerImage" Cursor="Hand" MouseLeftButtonDown="BannerImage_Click">
                            <Border.Background>
                                <ImageBrush x:Name="BannerBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <!-- информация -->
                        <Border Grid.Column="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0E1C29" Offset="0"/>
                                    <GradientStop Color="#0A141D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="BannerContent" Margin="18,16,18,16">
                                <StackPanel>
                                    <TextBlock x:Name="BannerTitle" Text="Cyberpunk 2077" Foreground="White" FontSize="24"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="68"/>
                                    <TextBlock x:Name="BannerText" Text="Описание" Foreground="#C7D5E0" FontSize="13"
                                               TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0"/>

                                    <TextBlock Text="Уже доступно" Foreground="White" FontSize="15" Margin="0,22,0,6"/>
                                    <WrapPanel>
                                        <Border Background="#3367C1F5" CornerRadius="2" Padding="7,2" Margin="0,0,4,4">
                                            <TextBlock x:Name="BannerTag" Text="ХИТ ПРОДАЖ" Foreground="#67C1F5" FontSize="11"/>
                                        </Border>
                                        <Border Background="#3367C1F5" CornerRadius="2" Padding="7,2" Margin="0,0,4,4">
                                            <TextBlock x:Name="BannerGenre" Text="RPG" Foreground="#67C1F5" FontSize="11"/>
                                        </Border>
                                        <Border Background="#3367C1F5" CornerRadius="2" Padding="7,2" Margin="0,0,4,4">
                                            <TextBlock Text="Ключ Steam" Foreground="#67C1F5" FontSize="11"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- цена + кнопка -->
                                <Grid VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border x:Name="BannerDiscountBox" Background="{StaticResource DiscountBgBrush}" Padding="6,0">
                                            <TextBlock x:Name="BannerDiscount" Text="-33%" Foreground="{StaticResource PriceGreenBrush}"
                                                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="{StaticResource PriceBgBrush}" Padding="8,3">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="BannerOldPrice" Text="" Foreground="#738895" FontSize="11"
                                                           TextDecorations="Strikethrough"/>
                                                <TextBlock x:Name="BannerPrice" Text="" Foreground="{StaticResource PriceGreenBrush}"
                                                           FontSize="15"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Button Content="В корзину" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="BannerBuy_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- точки -->
                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                <!-- ===== ПОПОЛНЕНИЕ КОШЕЛЬКА STEAM ===== -->
                <TextBlock Text="КОШЕЛЁК STEAM" Style="{StaticResource SectionTitle}" Margin="0,34,0,0"/>
                <Border Style="{StaticResource SectionLine}"/>

                <Grid Height="150" Cursor="Hand" MouseLeftButtonDown="TopUpBanner_Click">
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/topup.jpg" Stretch="UniformToFill"
                                        AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EE0E1C29" Offset="0"/>
                                <GradientStop Color="#990E1C29" Offset="0.5"/>
                                <GradientStop Color="#000E1C29" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="32,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="Пополнение кошелька Steam" Foreground="White" FontSize="24"/>
                        <TextBlock Text="Без комиссии банка  •  Зачисление за 1 минуту  •  От 100 ₽" Foreground="#C7D5E0"
                                   FontSize="13" Margin="0,4,0,14"/>
                        <Button Content="Пополнить баланс" Style="{StaticResource BlueButton}"
                                HorizontalAlignment="Left" Click="TopUpButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ===== КАТАЛОГ ===== -->
                <Grid Margin="0,34,0,0">
                    <TextBlock Text="ВСЕ ИГРЫ" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="FoundText" Text="" Foreground="{StaticResource GrayText}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <Border Style="{StaticResource SectionLine}"/>

                <!-- список игр -->
                <ItemsControl x:Name="GamesList" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameCard}" Width="290" Margin="0,0,16,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Image Source="{Binding Image}" Height="136" Stretch="UniformToFill"/>
                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock Text="{Binding Name}" Foreground="#C7D5E0" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#33384959" CornerRadius="2" Padding="6,1" Margin="0,4,0,10"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Genre}" Foreground="#8F98A0" FontSize="11"/>
                                        </Border>
                                        <Grid>
                                            <!-- цена в стиле Steam -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="34">
                                                <Border Background="{StaticResource DiscountBgBrush}" Padding="5,0"
                                                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DiscountText}" Foreground="{StaticResource PriceGreenBrush}"
                                                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="{StaticResource PriceBgBrush}" Padding="7,0">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OldPriceText}" Foreground="#738895" FontSize="10"
                                                                   TextDecorations="Strikethrough"
                                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding PriceText}" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                                            <Setter Property="Foreground" Value="#BEEE11"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Button Content="В корзину" Style="{StaticResource AccentButton}" Padding="12,6"
                                                    FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="AddToCart_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Text="Нет результатов, соответствующих вашему запросу."
                           Foreground="{StaticResource GrayText}" FontSize="14" HorizontalAlignment="Center"
                           Margin="0,40" Visibility="Collapsed"/>
            </StackPanel>

            <!-- ===== ПОДВАЛ (как у Steam) ===== -->
            <Border Background="{StaticResource HeaderBrush}" Margin="0,40,0,0" Padding="40,24">
                <StackPanel MaxWidth="1240">
                    <Border Height="1" Background="#363C44" Margin="0,0,0,16"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KUPISTEAM" Foreground="#8F98A0" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="© 2026 KupiSteam. Учебный проект. Все товарные знаки являются собственностью&#x0a;соответствующих владельцев в США и других странах."
                                       Foreground="#8F98A0" FontSize="12" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="#363C44" Margin="0,16,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="О KupiSteam" Foreground="#C6D4DF" FontSize="12"/>
                        <TextBlock Text="  |  " Foreground="#3A3F45" FontSize="12"/>
                        <TextBlock Text="Гарантии" Foreground="#C6D4DF" FontSize="12"/>
                        <TextBlock Text="  |  " Foreground="#3A3F45" FontSize="12"/>
                        <TextBlock Text="Поддержка" Foreground="#C6D4DF" FontSize="12"/>
                        <TextBlock Text="  |  " Foreground="#3A3F45" FontSize="12"/>
                        <TextBlock Text="Контакты" Foreground="#C6D4DF" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
