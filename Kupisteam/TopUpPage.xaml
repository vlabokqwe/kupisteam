<Page x:Class="Kupisteam.TopUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пополнение Steam">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,40" MaxWidth="1240">

            <!-- Шапка страницы с картинкой -->
            <Grid Height="180">
                <Border CornerRadius="22">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Images/topup.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="48,0,0,0">
                    <TextBlock Text="Пополнение Steam" Foreground="White" FontSize="38" FontWeight="Black"/>
                    <TextBlock Text="Пополняй кошелёк Steam из России быстро и безопасно" Foreground="#C8C8DD"
                               FontSize="16" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- ===== ФОРМА ===== -->
                <Border Style="{StaticResource Panel}" Padding="32">
                    <StackPanel>
                        <TextBlock Text="1. Логин аккаунта Steam" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Указывай именно логин для входа, а не никнейм" Foreground="{StaticResource GrayText}"
                                   FontSize="13" Margin="0,4,0,12"/>
                        <TextBox x:Name="SteamLoginBox" Style="{StaticResource DarkTextBox}" Tag="Например: gamer2026"/>

                        <TextBlock Text="2. Сумма пополнения" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,30,0,0"/>
                        <TextBlock Text="От 100 до 15 000 ₽" Foreground="{StaticResource GrayText}"
                                   FontSize="13" Margin="0,4,0,12"/>
                        <TextBox x:Name="AmountBox" Style="{StaticResource DarkTextBox}" Tag="Введите сумму в рублях"
                                 FontSize="20" FontWeight="SemiBold" TextChanged="AmountBox_TextChanged"
                                 PreviewTextInput="AmountBox_PreviewTextInput"/>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="100 ₽" Tag="100" Style="{StaticResource GhostButton}" Margin="0,0,10,10" Click="Quick_Click"/>
                            <Button Content="300 ₽" Tag="300" Style="{StaticResource GhostButton}" Margin="0,0,10,10" Click="Quick_Click"/>
                            <Button Content="500 ₽" Tag="500" Style="{StaticResource GhostButton}" Margin="0,0,10,10" Click="Quick_Click"/>
                            <Button Content="1 000 ₽" Tag="1000" Style="{StaticResource GhostButton}" Margin="0,0,10,10" Click="Quick_Click"/>
                            <Button Content="2 000 ₽" Tag="2000" Style="{StaticResource GhostButton}" Margin="0,0,10,10" Click="Quick_Click"/>
                            <Button Content="5 000 ₽" Tag="5000" Style="{StaticResource GhostButton}" Margin="0,0,10,10" Click="Quick_Click"/>
                        </WrapPanel>

                        <!-- шаги -->
                        <UniformGrid Columns="3" Margin="0,24,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Black"/>
                                <TextBlock Text="Введи логин и сумму" Foreground="{StaticResource GrayText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Black"/>
                                <TextBlock Text="Оплати с баланса KupiSteam" Foreground="{StaticResource GrayText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Black"/>
                                <TextBlock Text="Деньги придут в Steam за минуту" Foreground="{StaticResource GrayText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ===== ИТОГ ===== -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="28" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Ваш заказ" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Зачислим в Steam" Foreground="{StaticResource GrayText}" FontSize="15"/>
                            <TextBlock x:Name="ReceiveText" Text="0 ₽" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Комиссия сервиса (5%)" Foreground="{StaticResource GrayText}" FontSize="15"/>
                            <TextBlock x:Name="FeeText" Text="0 ₽" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Ваш баланс" Foreground="{StaticResource GrayText}" FontSize="15"/>
                            <TextBlock x:Name="UserBalanceText" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,16"/>

                        <Grid>
                            <TextBlock Text="К оплате" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText" Text="0 ₽" Foreground="White" FontSize="30"
                                       FontWeight="Black" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Text="" Foreground="#FF6B8B" FontSize="13" Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="PayButton" Content="Оплатить" Style="{StaticResource AccentButton}"
                                FontSize="16" Padding="0,15" Margin="0,16,0,0" Click="Pay_Click"/>

                        <TextBlock Text="Нажимая «Оплатить», вы соглашаетесь с правилами сервиса"
                                   Foreground="#6E6E88" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
