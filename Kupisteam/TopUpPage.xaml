<Page x:Class="Kupisteam.TopUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пополнение Steam" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,40,40" MaxWidth="1240">
            <TextBlock Text="Главная  >  Пополнение кошелька Steam" Style="{StaticResource Breadcrumb}"/>
            <TextBlock Text="Пополнение кошелька Steam" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Средства в кошельке Steam можно потратить на игры, DLC и предметы на Торговой площадке."
                       Foreground="{StaticResource GrayText}" FontSize="13" Margin="0,6,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- ===== ЛОГИН ===== -->
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Логин аккаунта Steam" Foreground="White" FontSize="16" FontWeight="Light"/>
                            <Border Style="{StaticResource SectionLine}"/>
                            <TextBlock Text="Указывайте именно логин для входа, а не никнейм в профиле."
                                       Foreground="{StaticResource GrayText}" FontSize="12" Margin="0,0,0,10"/>
                            <TextBox x:Name="SteamLoginBox" Style="{StaticResource DarkTextBox}" Tag="Например: gamer2026"
                                     MaxWidth="400" HorizontalAlignment="Left" Width="400"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== СУММА ===== -->
                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Сумма пополнения" Foreground="White" FontSize="16" FontWeight="Light"/>
                            <Border Style="{StaticResource SectionLine}"/>
                            <TextBlock Text="От 100 до 15 000 ₽" Foreground="{StaticResource GrayText}" FontSize="12"
                                       Margin="0,0,0,10"/>
                            <TextBox x:Name="AmountBox" Style="{StaticResource DarkTextBox}" Tag="Введите сумму в рублях"
                                     Width="400" HorizontalAlignment="Left" FontSize="16"
                                     TextChanged="AmountBox_TextChanged" PreviewTextInput="AmountBox_PreviewTextInput"/>

                            <!-- быстрые суммы как карточки «Добавить средства» в Steam -->
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="100 ₽" Tag="100" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,8" Click="Quick_Click"/>
                                <Button Content="300 ₽" Tag="300" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,8" Click="Quick_Click"/>
                                <Button Content="500 ₽" Tag="500" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,8" Click="Quick_Click"/>
                                <Button Content="1 000 ₽" Tag="1000" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,8" Click="Quick_Click"/>
                                <Button Content="2 000 ₽" Tag="2000" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,8" Click="Quick_Click"/>
                                <Button Content="5 000 ₽" Tag="5000" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,8" Click="Quick_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== КАК ЭТО РАБОТАЕТ ===== -->
                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Как это работает" Foreground="White" FontSize="16" FontWeight="Light"/>
                            <Border Style="{StaticResource SectionLine}"/>
                            <TextBlock Foreground="#C7D5E0" FontSize="13" LineHeight="22">
                                <Run Text="1.  Введите логин Steam и сумму пополнения."/><LineBreak/>
                                <Run Text="2.  Оплатите заказ с баланса KupiSteam."/><LineBreak/>
                                <Run Text="3.  Средства поступят в кошелёк Steam в течение минуты."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== ИТОГ ===== -->
                <Border Grid.Column="2" Padding="16" VerticalAlignment="Top" CornerRadius="3" Background="#0F1A26">
                    <StackPanel>
                        <TextBlock Text="Ваш заказ" Foreground="White" FontSize="16" FontWeight="Light" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Зачислим в Steam" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock x:Name="ReceiveText" Text="0 ₽" Foreground="#C7D5E0" FontSize="13"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Комиссия сервиса (5%)" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock x:Name="FeeText" Text="0 ₽" Foreground="#C7D5E0" FontSize="13"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ваш баланс" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock x:Name="UserBalanceText" Text="—" Foreground="#66C0F4" FontSize="13"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="#2A3F5A" Margin="0,6,0,12"/>

                        <Grid>
                            <TextBlock Text="Итого:" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText" Text="0 ₽" Foreground="White" FontSize="18"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="PayButton" Content="Оплатить" Style="{StaticResource AccentButton}"
                                FontSize="15" Padding="0,10" Margin="0,10,0,0" Click="Pay_Click"/>

                        <TextBlock Text="Нажимая «Оплатить», вы соглашаетесь с правилами сервиса."
                                   Foreground="#61686D" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
