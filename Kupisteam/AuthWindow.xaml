<Window x:Class="Kupisteam.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в KupiSteam" Height="580" Width="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="22" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== ЛЕВАЯ ЧАСТЬ С КАРТИНКОЙ ===== -->
            <Border CornerRadius="22,0,0,22">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Images/banner_1245620.jpg" Stretch="UniformToFill"
                                AlignmentX="Center"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="22,0,0,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#308A5CFF" Offset="0"/>
                        <GradientStop Color="#F00D0D17" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,36">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kupi" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Steam" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Игры, ключи и пополнение Steam по лучшим ценам" Foreground="#D0D0E0"
                           FontSize="15" TextWrapping="Wrap" Margin="0,8,0,16"/>
                <Border Background="#40000000" CornerRadius="10" Padding="14,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="+500 ₽ на баланс за регистрацию" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== ПРАВАЯ ЧАСТЬ: ФОРМЫ ===== -->
            <Grid Grid.Column="1" Margin="40,24,40,30">
                <Button Content="&#xE711;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,0,-20,0" Click="Close_Click"/>

                <StackPanel VerticalAlignment="Center">
                    <!-- переключатель -->
                    <Border Background="#1B1B2E" CornerRadius="12" Padding="4" Margin="0,0,0,26">
                        <UniformGrid Columns="2">
                            <Button x:Name="TabLogin" Content="Вход" Style="{StaticResource AccentButton}"
                                    Padding="0,10" Click="TabLogin_Click"/>
                            <Button x:Name="TabRegister" Content="Регистрация" Style="{StaticResource AccentButton}"
                                    Padding="0,10" Click="TabRegister_Click"/>
                        </UniformGrid>
                    </Border>

                    <!-- ВХОД -->
                    <StackPanel x:Name="LoginForm">
                        <TextBlock Text="С возвращением!" Foreground="White" FontSize="26" FontWeight="Black"/>
                        <TextBlock Text="Войдите, чтобы покупать игры" Foreground="{StaticResource GrayText}"
                                   FontSize="14" Margin="0,4,0,20"/>

                        <TextBlock Text="Логин" Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="LoginBox" Style="{StaticResource DarkTextBox}" Tag="Ваш логин"/>
                        <TextBlock Text="Пароль" Foreground="{StaticResource GrayText}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="LoginPassword" Style="{StaticResource DarkPasswordBox}"/>

                        <TextBlock x:Name="LoginError" Text="" Foreground="#FF6B8B" FontSize="13" Margin="0,12,0,0"/>
                        <Button Content="Войти" Style="{StaticResource AccentButton}" FontSize="16" Padding="0,13"
                                Margin="0,10,0,0" IsDefault="True" Click="DoLogin_Click"/>
                    </StackPanel>

                    <!-- РЕГИСТРАЦИЯ -->
                    <StackPanel x:Name="RegisterForm" Visibility="Collapsed">
                        <TextBlock Text="Создать аккаунт" Foreground="White" FontSize="26" FontWeight="Black"/>
                        <TextBlock Text="Это займёт меньше минуты" Foreground="{StaticResource GrayText}"
                                   FontSize="14" Margin="0,4,0,14"/>

                        <TextBlock Text="Логин" Foreground="{StaticResource GrayText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RegLogin" Style="{StaticResource DarkTextBox}" Tag="Придумайте логин" Padding="12,8"/>
                        <TextBlock Text="Почта" Foreground="{StaticResource GrayText}" Margin="0,8,0,4"/>
                        <TextBox x:Name="RegEmail" Style="{StaticResource DarkTextBox}" Tag="example@mail.ru" Padding="12,8"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Пароль" Foreground="{StaticResource GrayText}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="RegPassword" Style="{StaticResource DarkPasswordBox}" Padding="12,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Повтор пароля" Foreground="{StaticResource GrayText}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="RegPassword2" Style="{StaticResource DarkPasswordBox}" Padding="12,8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="RegError" Text="" Foreground="#FF6B8B" FontSize="13" Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                        <Button Content="Зарегистрироваться" Style="{StaticResource AccentButton}" FontSize="16"
                                Padding="0,13" Margin="0,8,0,0" Click="DoRegister_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
