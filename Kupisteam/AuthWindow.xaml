<Window x:Class="Kupisteam.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в KupiSteam" Height="600" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="12" BorderBrush="#000000" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#212429" Offset="0"/>
                <GradientStop Color="#181A21" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== ЗАГОЛОВОК ОКНА (как у клиента Steam) ===== -->
            <Border Background="#171A21">
                <Grid>
                    <TextBlock Text="KUPISTEAM" Foreground="#8F98A0" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Content="&#xE711;" Style="{StaticResource IconButton}" Background="Transparent"
                            Width="32" Height="32" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="40,24,40,24">
                <!-- вкладки -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="TabLogin" Content="Вход" Style="{StaticResource TabButton}" Click="TabLogin_Click"/>
                    <Button x:Name="TabRegister" Content="Регистрация" Style="{StaticResource TabButton}"
                            Margin="4,0,0,0" Click="TabRegister_Click"/>
                </StackPanel>

                <!-- ВХОД -->
                <StackPanel x:Name="LoginForm">
                    <TextBlock Text="Войти" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="ВОЙТИ, ИСПОЛЬЗУЯ ИМЯ АККАУНТА" Foreground="#1999FF" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource DarkTextBox}" Tag="" Padding="10,10"/>
                    <TextBlock Text="ПАРОЛЬ" Foreground="#AFAFAF" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="LoginPassword" Style="{StaticResource DarkPasswordBox}" Padding="10,10"/>

                    <TextBlock x:Name="LoginError" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="13" Margin="0,12,0,0"/>
                    <Button Content="Войти" Style="{StaticResource BlueButton}" FontSize="16" Padding="0,11"
                            Margin="0,10,0,0" Width="270" HorizontalAlignment="Center" IsDefault="True"
                            Click="DoLogin_Click"/>

                    <Border Background="#1F2328" Padding="14,10" Margin="0,30,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Впервые здесь? Получите 500 ₽ на баланс за регистрацию."
                                       Foreground="#AFAFAF" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- РЕГИСТРАЦИЯ -->
                <StackPanel x:Name="RegisterForm" Visibility="Collapsed">
                    <TextBlock Text="Создание аккаунта" Foreground="White" FontSize="30" FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="ИМЯ АККАУНТА" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="RegLogin" Style="{StaticResource DarkTextBox}" Tag="Придумайте логин" Padding="10,7"/>
                    <TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                    <TextBox x:Name="RegEmail" Style="{StaticResource DarkTextBox}" Tag="example@mail.ru" Padding="10,7"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="RegPassword" Style="{StaticResource DarkPasswordBox}" Padding="10,7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ПОВТОР ПАРОЛЯ" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="RegPassword2" Style="{StaticResource DarkPasswordBox}" Padding="10,7"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="RegError" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="13" Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                    <Button Content="Продолжить" Style="{StaticResource BlueButton}" FontSize="16"
                            Padding="0,11" Margin="0,8,0,0" Width="270" HorizontalAlignment="Center"
                            Click="DoRegister_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
