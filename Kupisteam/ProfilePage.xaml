<Page x:Class="Kupisteam.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,40,40" MaxWidth="1240">

            <!-- Не вошёл -->
            <Border x:Name="GuestPanel" Style="{StaticResource Panel}" Padding="30" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Вход в аккаунт" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Чтобы увидеть профиль, кошелёк и историю покупок, войдите в аккаунт."
                               Foreground="{StaticResource GrayText}" FontSize="13" Margin="0,8,0,18"/>
                    <Button Content="Войти / Зарегистрироваться" Style="{StaticResource BlueButton}"
                            HorizontalAlignment="Left" Click="Login_Click"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="UserPanel">
                <!-- ===== ШАПКА ПРОФИЛЯ ===== -->
                <Border Padding="24" Background="#66000000">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <!-- аватар: квадрат с синей рамкой «в сети» -->
                            <Border Width="166" Height="166" Padding="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#53A4C4" Offset="0"/>
                                        <GradientStop Color="#2D73A0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#2A475E">
                                    <TextBlock x:Name="AvatarLetter" Text="A" Foreground="White" FontSize="72" FontWeight="Light"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <StackPanel Margin="24,4,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="LoginText" Text="Login" Foreground="White" FontSize="24"/>
                                <TextBlock x:Name="EmailText" Text="mail" Foreground="{StaticResource GrayText}" FontSize="13"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="В сети" Foreground="#57CBDE" FontSize="13" Margin="0,16,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="240">
                            <TextBlock Text="Кошелёк Steam" Foreground="White" FontSize="18" FontWeight="Light"/>
                            <TextBlock x:Name="BalanceText" Text="0 ₽" Foreground="#66C0F4" FontSize="30" Margin="0,4,0,0"/>
                            <Button Content="Выйти из аккаунта" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Click="Logout_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== ИСТОРИЯ ПОКУПОК ===== -->
                    <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Недавняя активность" Foreground="White" FontSize="16" FontWeight="Light"/>
                            <Border Style="{StaticResource SectionLine}"/>
                            <TextBlock x:Name="NoOrdersText" Text="Покупок пока нет." Foreground="{StaticResource GrayText}"
                                       FontSize="13"/>
                            <ItemsControl x:Name="OrdersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A2B3C" Padding="12,10" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [2]}" Foreground="#C7D5E0" FontSize="13"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding [1]}" Foreground="{StaticResource GrayText}" FontSize="11"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Foreground="#C7D5E0" FontSize="13"
                                                           VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Run Text="-"/><Run Text="{Binding [3], Mode=OneWay}"/><Run Text=" ₽"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== ПОПОЛНЕНИЕ БАЛАНСА ===== -->
                    <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Пополнить кошелёк" Foreground="White" FontSize="16" FontWeight="Light"/>
                            <Border Style="{StaticResource SectionLine}"/>
                            <TextBlock Text="Средства можно тратить на игры и пополнение Steam."
                                       Foreground="{StaticResource GrayText}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                            <TextBlock Text="НОМЕР КАРТЫ" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CardBox" Style="{StaticResource DarkTextBox}" Tag="0000 0000 0000 0000"
                                     MaxLength="19"/>

                            <TextBlock Text="СУММА" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                            <TextBox x:Name="AmountBox" Style="{StaticResource DarkTextBox}" Tag="Например: 1000"
                                     PreviewTextInput="Digits_PreviewTextInput"/>

                            <UniformGrid Columns="4" Margin="0,8,0,0">
                                <Button Content="500" Tag="500" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="0,6" Click="Quick_Click"/>
                                <Button Content="1000" Tag="1000" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="0,6" Click="Quick_Click"/>
                                <Button Content="3000" Tag="3000" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="0,6" Click="Quick_Click"/>
                                <Button Content="5000" Tag="5000" Style="{StaticResource GhostButton}" Padding="0,6" Click="Quick_Click"/>
                            </UniformGrid>

                            <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <Button Content="Пополнить" Style="{StaticResource AccentButton}" FontSize="15"
                                    Padding="0,9" Margin="0,8,0,0" Click="AddMoney_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
