<Page x:Class="Kupisteam.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,40" MaxWidth="1240">

            <!-- Не вошёл -->
            <Border x:Name="GuestPanel" Style="{StaticResource Panel}" Padding="50" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="60"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Вы не вошли в аккаунт" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,20,0,20"/>
                    <Button Content="Войти / Зарегистрироваться" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Center" Click="Login_Click"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="UserPanel">
                <!-- ===== КАРТОЧКА ПОЛЬЗОВАТЕЛЯ ===== -->
                <Border CornerRadius="22" Padding="32">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A2470" Offset="0"/>
                            <GradientStop Color="#6B1F52" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="90" Height="90" CornerRadius="45" Background="{StaticResource AccentBrush}"
                                    BorderBrush="#40FFFFFF" BorderThickness="3">
                                <TextBlock x:Name="AvatarLetter" Text="A" Foreground="White" FontSize="40" FontWeight="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LoginText" Text="Login" Foreground="White" FontSize="30" FontWeight="Black"/>
                                <TextBlock x:Name="EmailText" Text="mail" Foreground="#D8C8F0" FontSize="15" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Баланс" Foreground="#D8C8F0" FontSize="14" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="BalanceText" Text="0 ₽" Foreground="White" FontSize="42" FontWeight="Black"
                                       HorizontalAlignment="Right"/>
                            <Button Content="Выйти из аккаунта" Style="{StaticResource GhostButton}" Background="#30000000"
                                    BorderBrush="#40FFFFFF" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Logout_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== ПОПОЛНЕНИЕ БАЛАНСА ===== -->
                    <Border Style="{StaticResource Panel}" Padding="28" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Пополнить баланс" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Деньги на балансе можно тратить на игры и Steam"
                                       Foreground="{StaticResource GrayText}" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap"/>

                            <TextBlock Text="Номер карты" Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="CardBox" Style="{StaticResource DarkTextBox}" Tag="0000 0000 0000 0000"
                                     MaxLength="19"/>

                            <TextBlock Text="Сумма" Foreground="{StaticResource GrayText}" Margin="0,14,0,6"/>
                            <TextBox x:Name="AmountBox" Style="{StaticResource DarkTextBox}" Tag="Например: 1000"
                                     PreviewTextInput="Digits_PreviewTextInput"/>

                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <Button Content="500" Tag="500" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="0,8" Click="Quick_Click"/>
                                <Button Content="1000" Tag="1000" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="0,8" Click="Quick_Click"/>
                                <Button Content="3000" Tag="3000" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="0,8" Click="Quick_Click"/>
                                <Button Content="5000" Tag="5000" Style="{StaticResource GhostButton}" Padding="0,8" Click="Quick_Click"/>
                            </UniformGrid>

                            <TextBlock x:Name="ErrorText" Text="" Foreground="#FF6B8B" FontSize="13" Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                            <Button Content="Пополнить" Style="{StaticResource AccentButton}" FontSize="16"
                                    Padding="0,14" Margin="0,12,0,0" Click="AddMoney_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== ИСТОРИЯ ЗАКАЗОВ ===== -->
                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="28" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="История покупок" Foreground="White" FontSize="20" FontWeight="Bold"
                                       Margin="0,0,0,18"/>
                            <TextBlock x:Name="NoOrdersText" Text="Покупок пока нет" Foreground="{StaticResource GrayText}"
                                       FontSize="15"/>
                            <ItemsControl x:Name="OrdersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B1B2E" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#2A1F4D">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#B79BFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding [2]}" Foreground="White" FontSize="14"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding [1]}" Foreground="{StaticResource GrayText}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Foreground="{StaticResource PinkBrush}" FontSize="16"
                                                           FontWeight="Bold" VerticalAlignment="Center">
                                                    <Run Text="-"/><Run Text="{Binding [3], Mode=OneWay}"/><Run Text=" ₽"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
