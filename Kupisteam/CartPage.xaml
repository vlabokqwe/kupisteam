<Page x:Class="Kupisteam.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,40" MaxWidth="1240">
            <TextBlock Text="Корзина" Foreground="White" FontSize="34" FontWeight="Black" Margin="0,0,0,24"/>

            <!-- Пустая корзина -->
            <Border x:Name="EmptyPanel" Style="{StaticResource Panel}" Padding="50" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="60"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="В корзине пока пусто" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBlock Text="Загляни в каталог — там много крутых игр со скидками"
                               Foreground="{StaticResource GrayText}" FontSize="15" HorizontalAlignment="Center"/>
                    <Button Content="Перейти в каталог" Style="{StaticResource AccentButton}" Margin="0,24,0,0"
                            HorizontalAlignment="Center" Click="GoCatalog_Click"/>
                </StackPanel>
            </Border>

            <Grid x:Name="CartPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ===== СПИСОК ТОВАРОВ ===== -->
                <ItemsControl x:Name="CartList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Height="89" CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Game.Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Game.Genre}" Foreground="#A98BFF" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Game.Name}" Foreground="White" FontSize="18"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource GrayText}" FontSize="13" Margin="0,4,0,0">
                                            <Run Text="Ключ Steam • "/><Run Text="{Binding Game.PriceText, Mode=OneWay}"/><Run Text=" за шт."/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- количество -->
                                    <Border Grid.Column="2" Background="#1B1B2E" CornerRadius="20" Padding="4"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&#xE738;" Style="{StaticResource IconButton}" Width="32" Height="32"
                                                    FontSize="11" Tag="{Binding}" Click="Minus_Click"/>
                                            <TextBlock Text="{Binding Count}" Foreground="White" FontSize="16" FontWeight="Bold"
                                                       Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="32" Height="32"
                                                    FontSize="11" Tag="{Binding}" Click="Plus_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="{Binding SumText}" Foreground="White" FontSize="20"
                                               FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right"/>

                                    <Button Grid.Column="4" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                            Background="Transparent" Foreground="#FF6B8B" Margin="16,0,6,0"
                                            ToolTip="Удалить" Tag="{Binding}" Click="Remove_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== ИТОГ ===== -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="28" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Итого" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="CountText" Text="Товары (0)" Foreground="{StaticResource GrayText}" FontSize="15"/>
                            <TextBlock x:Name="SubtotalText" Text="0 ₽" Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Скидка по промокоду" Foreground="{StaticResource GrayText}" FontSize="15"/>
                            <TextBlock x:Name="DiscountText" Text="0 ₽" Foreground="{StaticResource GreenBrush}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- промокод -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PromoBox" Style="{StaticResource DarkTextBox}" Tag="Промокод"/>
                            <Button Grid.Column="1" Content="OK" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="Promo_Click"/>
                        </Grid>
                        <TextBlock x:Name="PromoInfo" Text="Подсказка: попробуй STUDENT или KUPI20"
                                   Foreground="#6E6E88" FontSize="12" Margin="0,6,0,0"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,16"/>

                        <Grid>
                            <TextBlock Text="К оплате" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText" Text="0 ₽" Foreground="White" FontSize="30"
                                       FontWeight="Black" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Text="" Foreground="#FF6B8B" FontSize="13" Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>

                        <Button Content="Оформить заказ" Style="{StaticResource AccentButton}"
                                FontSize="16" Padding="0,15" Margin="0,16,0,0" Click="Checkout_Click"/>
                        <Button Content="Очистить корзину" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                Click="Clear_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
