<Page x:Class="Kupisteam.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,40,40" MaxWidth="1240">
            <TextBlock Text="Главная  >  Ваша корзина" Style="{StaticResource Breadcrumb}"/>
            <TextBlock Text="Ваша корзина" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

            <!-- Пустая корзина -->
            <Border x:Name="EmptyPanel" Style="{StaticResource Panel}" Padding="30" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Ваша корзина пуста." Foreground="White" FontSize="16"/>
                    <TextBlock Text="Загляните в магазин — там много игр со скидками."
                               Foreground="{StaticResource GrayText}" FontSize="13" Margin="0,6,0,0"/>
                    <Button Content="Продолжить покупки" Style="{StaticResource BlueButton}" Margin="0,18,0,0"
                            HorizontalAlignment="Left" Click="GoCatalog_Click"/>
                </StackPanel>
            </Border>

            <Grid x:Name="CartPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- ===== СПИСОК ТОВАРОВ ===== -->
                <StackPanel>
                    <ItemsControl x:Name="CartList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2B3D52" Offset="0"/>
                                            <GradientStop Color="#1E2C3C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="184"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding Game.Image}" Height="69" Stretch="UniformToFill"/>

                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Game.Name}" Foreground="White" FontSize="16"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{StaticResource GrayText}" FontSize="12" Margin="0,3,0,8">
                                                <Run Text="{Binding Game.Genre, Mode=OneWay}"/><Run Text="  •  Ключ Steam  •  "/><Run Text="{Binding Game.PriceText, Mode=OneWay}"/><Run Text=" за шт."/>
                                            </TextBlock>
                                            <!-- количество -->
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#xE738;" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                        FontSize="9" Tag="{Binding}" Click="Minus_Click"/>
                                                <TextBlock Text="{Binding Count}" Foreground="White" FontSize="13"
                                                           Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                                                <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                        FontSize="9" Tag="{Binding}" Click="Plus_Click"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SumText}" Foreground="#C7D5E0" FontSize="15"
                                                       HorizontalAlignment="Right"/>
                                            <Button Content="Удалить" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                                    Margin="0,8,0,0" Tag="{Binding}" Click="Remove_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,6,0,0">
                        <Button Content="Продолжить покупки" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Click="GoCatalog_Click"/>
                        <Button Content="Удалить все товары" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Click="Clear_Click"/>
                    </Grid>
                </StackPanel>

                <!-- ===== ИТОГ ===== -->
                <Border Grid.Column="2" Padding="16" VerticalAlignment="Top" CornerRadius="3" Background="#0F1A26">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="CountText" Text="Товары (0)" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock x:Name="SubtotalText" Text="0 ₽" Foreground="#C7D5E0" FontSize="13"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Скидка по промокоду" Foreground="{StaticResource GrayText}" FontSize="13"/>
                            <TextBlock x:Name="DiscountText" Text="0 ₽" Foreground="{StaticResource PriceGreenBrush}" FontSize="13"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Итого:" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText" Text="0 ₽" Foreground="White" FontSize="18"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="#2A3F5A" Margin="0,14,0,14"/>

                        <!-- промокод -->
                        <TextBlock Text="ПРОМОКОД" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PromoBox" Style="{StaticResource DarkTextBox}" Tag="Введите код"/>
                            <Button Grid.Column="1" Content="Применить" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Click="Promo_Click"/>
                        </Grid>
                        <TextBlock x:Name="PromoInfo" Text="Подсказка: попробуй STUDENT или KUPI20"
                                   Foreground="#61686D" FontSize="11" Margin="0,6,0,0"/>

                        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <Button Content="Оплатить" Style="{StaticResource BlueButton}"
                                FontSize="15" Padding="0,10" Margin="0,10,0,0" Click="Checkout_Click"/>
                        <TextBlock Text="Ключи будут отправлены на почту, указанную в аккаунте."
                                   Foreground="{StaticResource GrayText}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
